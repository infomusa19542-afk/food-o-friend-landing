# Copy to .env.local and fill in. See ENVIRONMENT_SETUP.md.

# Required — public Supabase credentials (safe in the browser because RLS limits the public role)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Recommended in production — canonical site origin (no trailing slash)
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Local admin scripts only — NEVER add to Vercel, NEVER prefix with NEXT_PUBLIC_
# SUPABASE_SECRET_KEY=
